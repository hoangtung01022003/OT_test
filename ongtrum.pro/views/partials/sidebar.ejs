<script>
    (function () {
        var KEY = 'sidebarScrollTop';
        var navEl = document.querySelector('.sidebar-nav[data-simplebar]');
        if (!navEl) return;

        function scrollTarget() {
            if (window.SimpleBar && window.SimpleBar.instances && window.SimpleBar.instances.get(navEl)) {
                return window.SimpleBar.instances.get(navEl).getScrollElement();
            }
            return navEl;
        }

        window.addEventListener('load', function () {
            var target = scrollTarget();
            var saved = sessionStorage.getItem(KEY);
            if (saved) target.scrollTop = parseInt(saved, 10) || 0;
            target.addEventListener('scroll', function () {
                sessionStorage.setItem(KEY, String(target.scrollTop));
            });
        });
    })();
</script>
